<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CoreTeamProject" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colori principali -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_500</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Sfondo -->
        <item name="android:windowBackground">@color/background_cream</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>

        <!-- Testo -->
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>

        <!-- App Bar -->
        <item name="colorPrimaryContainer">@color/purple_500</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
    </style>

    <style name="Theme.CoreTeamProject" parent="Base.Theme.CoreTeamProject" />

    <style name="Theme.CoreTeamProject.Admin" parent="Base.Theme.CoreTeamProject">
        <item name="colorPrimary">@color/admin_primary</item>
        <item name="colorPrimaryVariant">@color/admin_primary_variant</item>
        <item name="colorPrimaryContainer">@color/admin_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
    </style>

    <style name="AppCustomIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/white</item>
        <item name="android:animationDuration">0</item>
    </style>
</resources>