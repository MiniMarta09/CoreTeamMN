<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.coreteamproject.HomeFragment"
        android:label="HomeFragment">
        <action
            android:id="@+id/action_homeFragment_to_diaryFragment"
            app:destination="@id/diaryFragment" />
        <action
            android:id="@+id/action_homeFragment_to_eventFragment"
            app:destination="@id/eventFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.coreteamproject.ProfileFragment"
        android:label="ProfileFragment" />

    <fragment
        android:id="@+id/diaryFragment"
        android:name="com.example.coreteamproject.DiaryFragment"
        android:label="DiaryFragment" />
    <fragment
        android:id="@+id/eventFragment"
        android:name="com.example.coreteamproject.EventFragment"
        android:label="EventFragment" />

</navigation>