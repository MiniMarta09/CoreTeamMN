<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.coreteamproject.HomeFragment"
        android:label="HomeFragment">
        <action
            android:id="@+id/action_homeFragment_to_diaryFragment"
            app:destination="@id/diaryFragment" />
        <action
            android:id="@+id/action_homeFragment_to_eventFragment"
            app:destination="@id/eventFragment" />
        <action
            android:id="@+id/action_homeFragment_to_shiftFragment"
            app:destination="@id/shiftFragment" />
        <action
            android:id="@+id/action_homeFragment_to_teamFragment"
            app:destination="@id/teamFragment" />
        <action
            android:id="@+id/action_homeFragment_to_boardFragment"
            app:destination="@id/boardFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.coreteamproject.ProfileFragment"
        android:label="ProfileFragment">
    </fragment>

    <fragment
        android:id="@+id/diaryFragment"
        android:name="com.example.coreteamproject.DiaryFragment"
        android:label="DiaryFragment" />
    <fragment
        android:id="@+id/eventFragment"
        android:name="com.example.coreteamproject.EventFragment"
        android:label="EventFragment" />
    <fragment
        android:id="@+id/shiftFragment"
        android:name="com.example.coreteamproject.ShiftFragment"
        android:label="ShiftFragment">
    </fragment>
    <fragment
        android:id="@+id/teamFragment"
        android:name="com.example.coreteamproject.TeamFragment"
        android:label="TeamFragment">
    </fragment>
    <fragment
        android:id="@+id/boardFragment"
        android:name="com.example.coreteamproject.BoardFragment"
        android:label="BoardFragment" />
</navigation>