<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable
            name="viewModel"
            type="com.example.coreteamproject.UsersViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@color/background_cream">

            <!-- Header con pulsante Esci -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp">

                <Button
                    android:id="@+id/btn_logout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Esci"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/rounded_button_blue"
                    android:textSize="16sp"
                    android:padding="12dp" />

            </RelativeLayout>

            <TextView
                android:id="@+id/textViewProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Il tuo profilo"
                android:textColor="@color/purple_500"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textDescriptionprofile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aggiorna e personalizza il tuo profilo"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/textViewProfile"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.498"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp" />

            <!-- Nome -->
            <TextView
                android:text="Nome e Cognome"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/text_namelastname"
                android:text="Non disponibile"
                android:textSize="18sp"
                android:textColor="#333333"
                android:padding="12dp"
                android:background="#F0F0F0"
                android:layout_marginBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Data di nascita -->
            <TextView
                android:text="Data di nascita"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/edit_data_nascita"
                android:hint="es. 15/03/1990"
                android:textSize="18sp"
                android:textColor="#333333"
                android:padding="12dp"
                android:background="#F0F0F0"
                android:layout_marginBottom="20dp"
                android:enabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Email -->
            <TextView
                android:text="Email"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/text_email"
                android:text="Non disponibile"
                android:textSize="18sp"
                android:textColor="#333333"
                android:padding="12dp"
                android:background="#F0F0F0"
                android:layout_marginBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Settore di Occupazione -->
            <TextView
                android:text="Settore di Occupazione"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Spinner
                android:id="@+id/spinner_settore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="#F0F0F0"
                android:layout_marginBottom="20dp"
                android:enabled="false" />

            <!-- Password -->
            <TextView
                android:text="Password"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/edit_password"
                android:hint="••••••••"
                android:textSize="18sp"
                android:textColor="#333333"
                android:padding="12dp"
                android:background="#F0F0F0"
                android:layout_marginBottom="40dp"
                android:inputType="textPassword"
                android:enabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Pulsanti -->
            <Button
                android:id="@+id/btn_modifica"
                android:text="Modifica Profilo"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/rounded_button_blue"
                android:layout_marginBottom="15dp"
                android:layout_width="match_parent"
                android:layout_height="50dp" />

            <Button
                android:id="@+id/btn_salva"
                android:text="Salva"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/rounded_button_green"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="50dp" />

            <ProgressBar
                android:id="@+id/progressBarProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="@{viewModel.isLoading ? View.VISIBLE : View.GONE}"
                android:layout_marginTop="20dp" />

        </LinearLayout>

    </ScrollView>

</layout>