<?xml version="1.0" encoding="utf-8"?>
<!-- layout per una singola card evento con data binding -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- sezione data per il binding con il viewmodel -->
    <data>
        <variable
            name="evento"
            type="com.example.coreteamproject.Evento" />
        <import type="android.view.View"/>
    </data>

    <!-- cardview per un aspetto moderno -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@{evento.isPrivate ? @color/private_event_background : @color/public_event_background}">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- titolo dell'evento -->
            <TextView
                android:id="@+id/textViewEventTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@{evento.title}"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/imageViewPrivateIcon"
                tools:text="Titolo Evento" />

            <!-- icona per evento privato -->
            <ImageView
                android:id="@+id/imageViewPrivateIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_lock"
                android:visibility="@{evento.isPrivate ? View.VISIBLE : View.GONE}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textViewEventTitle"
                app:layout_constraintBottom_toBottomOf="@+id/textViewEventTitle"/>

            <!-- ora dell'evento -->
            <TextView
                android:id="@+id/textViewEventTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawableStart="@drawable/ic_time"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:text='@{evento.time}'
                android:textColor="@color/purple_500"
                android:visibility="@{evento.time.empty ? View.GONE : View.VISIBLE}"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewEventTitle"
                tools:text="14:30" />

            <!-- descrizione dell'evento -->
            <TextView
                android:id="@+id/textViewEventDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@{evento.description}"
                android:visibility="@{evento.description.empty ? View.GONE : View.VISIBLE}"
                android:textColor="@android:color/black"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewEventTime"
                tools:text="Questa è una descrizione di esempio per l'evento." />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>
